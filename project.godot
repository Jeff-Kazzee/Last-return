; Last Return — verified arcade vertical slice.
config_version=5

[application]
config/name="Last Return"
config/description="A readable arcade duel and connected return-combat breach."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.05, 1)

[physics]
common/physics_ticks_per_second=120

[audio]
default_bus_layout="res://assets/default_bus_layout.tres"
